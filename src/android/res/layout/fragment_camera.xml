<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <LinearLayout
        android:id="@+id/camera_frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/camera_zoom_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="gone">
        <TextView
            android:layout_width="32dp"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:layout_gravity="center|end"
            android:layout_marginTop="-90dp"
            android:textSize="32sp"
            android:layout_marginEnd="15dp"
            android:text="+"/>
        <SeekBar
            android:id="@+id/camera_zoom"
            android:layout_width="180dp"
            android:progress="0"
            android:layout_height="32dp"
            android:layout_gravity="center|end"
            android:layout_marginEnd="-60dp"
            android:rotation="270"/>
        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_gravity="center|end"
            android:layout_marginTop="90dp"
            android:textSize="32sp"
            android:layout_marginEnd="15dp"
            android:text="-"/>
    </FrameLayout>
    <!-- Barre du haut : retour à gauche ; annoter puis flash à droite (boutons ronds). -->
    <RelativeLayout
        android:id="@+id/cameraTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="visible">
        <ImageButton
            android:id="@+id/cancel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentLeft="true"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:background="@drawable/camera_round_dark"
            android:contentDescription="Retour"
            android:src="@drawable/back_arrow"/>
        <ImageButton
            android:id="@+id/draw_on"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentRight="true"
            android:layout_marginRight="56dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:background="@drawable/camera_round_blue"
            android:contentDescription="Dessiner sur la photo"
            android:src="@drawable/camera_edit"/>
    </RelativeLayout>
    <ImageButton
        android:id="@+id/flash_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentRight="true"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/camera_flash_off"
        android:contentDescription="Flash"
        android:background="@drawable/camera_round_dark"/>
    <ImageView
        android:visibility="invisible"
        android:id="@+id/image_souche"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:cropToPadding="true"
        android:layout_margin="15dp"
        android:scaleType="centerCrop"
        android:padding="3dp"
        android:background="@drawable/shape_rectangle"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:id="@+id/zoom_buttons_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/capture_frame"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center">
        <Button
            android:id="@+id/zoom_05x"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="0.5"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/zoom_1x"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="1x"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:background="@android:color/transparent"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/zoom_2x"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="2x"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/capture_frame"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="10dp">
        <ProgressBar
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminateDuration="2000"
            android:indeterminateDrawable="@drawable/custom_spinner"
            />
        <ImageButton
            android:id="@+id/button_capture"
            android:src="@drawable/camsicon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Prendre photo"
            android:background="@android:color/transparent"
            />
    </FrameLayout>
    <Button
        android:visibility="gone"
        android:id="@+id/valid_btn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:textStyle="bold"
        android:text="ok"
        android:background="@drawable/shape_back"
        android:textColor="@android:color/white"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_margin="25dp"/>
    <Button
        android:id="@+id/cancel_btn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:textStyle="bold"
        android:text="x"
        android:background="@drawable/shape_cancel"
        android:textColor="@android:color/white"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_margin="25dp"/>
</RelativeLayout>
